[Unit]
Description=Rustiron modern app standby slot B for site %i
After=network.target

[Service]
Type=simple
User=%i
Group=%i
# W659 (D-102): blue/green standby slot B unit for zero-downtime cutover.
# Identical confinement to rustiron-app@.service; per-site drop-in pins
# PORT=<standby_port>, SELinuxContext, and exact release path.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rustiron-app-b-%i
UMask=0027
KillMode=control-group
Restart=on-failure
RestartSec=3s

MemoryMax=512M
MemorySwapMax=0
TasksMax=64
CPUQuota=100%
IOReadBandwidthMax=/srv/sites 64M
IOWriteBandwidthMax=/srv/sites 32M
IOReadIOPSMax=/srv/sites 2000
IOWriteIOPSMax=/srv/sites 1000

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectSystem=strict
ReadWritePaths=/srv/sites/%i/data /srv/sites/%i/tmp
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-/etc/rustiron -/var/lib/rustiron -/run/rustiron -/run/rustiron-admin -/run/rustiron-coordinator -/var/lib/rustiron-coordinator -/run/rustiron-sites
TemporaryFileSystem=/dev/shm:mode=1777,nosuid,nodev,noexec

[Install]
WantedBy=multi-user.target
