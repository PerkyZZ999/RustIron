# D-035 (W386): missed-run detection. Reads every window's run state and
# the newest snapshot of each site through the coordinator; changes
# nothing. Exit 5 alerts (a missed or failed newest window, an RPO over
# the target, or no window left). Not enabled by default.
[Unit]
Description=Rustiron scheduled capture check (D-035)
Documentation=file:///usr/share/doc/rustiron/README.md
After=rustiron-coordinator.service
Wants=rustiron-coordinator.service
ConditionPathExists=/var/lib/rustiron-coordinator/standing/current/grant.json.sig

[Service]
Type=oneshot
User=rustiron-coordinator
Group=rustiron-coordinator
Environment=RUSTIRON_RPO_TARGET_SECONDS=86400
ExecStart=/usr/bin/rustiron --output json --socket /run/rustiron-coordinator/control.sock schedule status --dir /var/lib/rustiron-coordinator/standing/current --rpo-target-seconds ${RUSTIRON_RPO_TARGET_SECONDS}
TimeoutStartSec=5min
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=128M
TasksMax=16
