# D-035 (W386): one scheduled capture run. Submits, through the coordinator,
# the run of each site that the standing grant names for the window that is
# open now, then reports every window, missed runs and the snapshot age.
# The executor derives each run and checks the window with its own clock;
# this unit holds no key and widens no grant. Exit 5 alerts (a missed or
# failed newest window, an RPO over the target, or no window left); exit 3
# means no window was open. Not enabled by default.
[Unit]
Description=Rustiron scheduled capture (D-035)
Documentation=file:///usr/share/doc/rustiron/README.md
After=rustiron-coordinator.service
Wants=rustiron-coordinator.service
ConditionPathExists=/var/lib/rustiron-coordinator/standing/current/grant.json.sig

[Service]
Type=oneshot
User=rustiron-coordinator
Group=rustiron-coordinator
Environment=RUSTIRON_RPO_TARGET_SECONDS=86400
ExecStart=/usr/bin/rustiron --output json --socket /run/rustiron-coordinator/control.sock schedule run --dir /var/lib/rustiron-coordinator/standing/current --rpo-target-seconds ${RUSTIRON_RPO_TARGET_SECONDS}
# A window is at most 4 h; each site's capture runs inside it.
TimeoutStartSec=4h
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=128M
TasksMax=16
