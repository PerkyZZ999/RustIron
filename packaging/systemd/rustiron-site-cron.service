# D-061 (W466): ask each managed site's own PHP to run its due WordPress
# jobs through the local OLS listener. Reads the active OLS generation;
# changes nothing on the host. The jobs run in each site's confined pool.
[Unit]
Description=Rustiron WordPress jobs for every managed site (D-061)
Documentation=file:///usr/share/doc/rustiron/README.md
After=lshttpd.service

[Service]
Type=oneshot
User=rustiron-coordinator
Group=rustiron-coordinator
ExecStart=/usr/libexec/rustiron/rustiron-control --site-cron
TimeoutStartSec=20min
UMask=0077
# W474-F1: the run lock in the coordinator's state folder.
ReadWritePaths=/var/lib/rustiron-coordinator

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
# Only the local OLS listener.
IPAddressAllow=localhost
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=64M
TasksMax=8
