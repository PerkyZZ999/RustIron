[Unit]
Description=Rustiron modern app background worker for site %i
After=network.target rustiron-app@%i.service

[Service]
Type=simple
User=%i
Group=%i
# W599-F2: PID 1 (init_t:s0) does not chdir into or open MCS-labeled site
# files. The site's pinned runtime loads 0400 private/app.env in-process via
# --env-file(-if-exists) in the per-site drop-in, and ProtectSystem=strict
# keeps releases/ and current read-only while ReadWritePaths opens data/ and tmp/.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rustiron-app-worker-%i
UMask=0027
KillMode=control-group
Restart=on-failure
RestartSec=3s

# Default resource limits; per-site signed limits override via 10-rustiron-app.conf drop-in.
MemoryMax=512M
MemorySwapMax=0
TasksMax=64
CPUQuota=100%
IOReadBandwidthMax=/srv/sites 64M
IOWriteBandwidthMax=/srv/sites 32M
IOReadIOPSMax=/srv/sites 2000
IOWriteIOPSMax=/srv/sites 1000

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectSystem=strict
ReadWritePaths=/srv/sites/%i/data /srv/sites/%i/tmp
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# Required for V8 (Node.js) and JavaScriptCore (Bun) JIT code pages.
MemoryDenyWriteExecute=no
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Network boundary (C-01 / W633): background workers require no network sockets.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/etc/rustiron -/var/lib/rustiron -/run/rustiron -/run/rustiron-admin -/run/rustiron-coordinator -/var/lib/rustiron-coordinator -/run/rustiron-sites
TemporaryFileSystem=/dev/shm:mode=1777,nosuid,nodev,noexec

[Install]
WantedBy=multi-user.target
