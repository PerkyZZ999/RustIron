policy_module(rustiron_job_credential, 1.1.0)

gen_require(`
	type init_t, rustiron_executor_t, rustiron_admin_t;
')

type rustiron_job_credential_t;
files_type(rustiron_job_credential_t)

# Admission opens the site directory and stats its enrolled files.
list_dirs_pattern(rustiron_executor_t, rustiron_job_credential_t, rustiron_job_credential_t)
allow rustiron_executor_t rustiron_job_credential_t:file getattr;

# PID 1 reads the source for LoadCredential=.
read_files_pattern(init_t, rustiron_job_credential_t, rustiron_job_credential_t)

# W318: the admin helper launches store jobs and repeats the same
# metadata-only checks before naming the files in LoadCredential=.
list_dirs_pattern(rustiron_admin_t, rustiron_job_credential_t, rustiron_job_credential_t)
allow rustiron_admin_t rustiron_job_credential_t:file getattr;
