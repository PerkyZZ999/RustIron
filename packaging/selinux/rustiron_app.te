# C-01 / W640 (P27, D-099): dedicated MCS-constrained SELinux domain for
# confined Node.js 22 (node_22_v1) and Bun 1.4 (bun_1_v1) app services,
# companion background workers, and pre-activation migration jobs.
#
# Each app runs as system_u:system_r:rustiron_app_t:s0:c<N> matching its
# per-site MCS category on /srv/sites/rs_<site>/:
# - releases/, current, html/, private/ carry httpd_sys_content_t:s0:c<N>
#   (read-only in rustiron_app_t + ProtectSystem=strict).
# - data/, tmp/, logs/ carry httpd_sys_rw_content_t:s0:c<N> (read-write in
#   rustiron_app_t, MCS-isolated per site, with mmap/lock for SQLite WAL).
# - No corecmd_exec_bin: compromised JS/TS code cannot exec shells or host
#   binaries.
# - No corenet_tcp_connect_*: outbound TCP (including cross-app loopback TCP
#   to sibling app ports) is denied by SELinux in addition to systemd
#   IPAddressDeny=any / IPAddressAllow=localhost (app) and PrivateNetwork=yes
#   (worker & migration jobs).
policy_module(rustiron_app, 0.1.0)

gen_require(`
	type init_t, bin_t, httpd_sys_content_t, httpd_sys_rw_content_t;
	type passwd_file_t, proc_t, tmpfs_t, hugetlbfs_t, net_conf_t, fs_t;
	type cgroup_t, nsfs_t, unreserved_port_t, http_port_t;
	type sysctl_vm_t, var_t;
	role system_r;
')

type rustiron_app_t;
domain_type(rustiron_app_t)
role system_r types rustiron_app_t;
mcs_constrained(rustiron_app_t)

# Enter rustiron_app_t when PID 1 execs pinned /usr/bin/node(-22) or
# /usr/local/bin/bun (both bin_t) under NoNewPrivileges=yes.
corecmd_bin_entry_type(rustiron_app_t)
allow init_t rustiron_app_t:process transition;
allow init_t rustiron_app_t:process2 { nnp_transition nosuid_transition };
allow rustiron_app_t init_t:process sigchld;
init_use_fds(rustiron_app_t)

# Runtime process operations: V8/JSC JIT (execmem), libuv worker threads,
# internal wakeup pipes, and rlimits.
allow rustiron_app_t self:process { execmem signal sigchld getsched setsched setrlimit };
allow rustiron_app_t self:fifo_file rw_fifo_file_perms;
allow rustiron_app_t self:unix_stream_socket create_stream_socket_perms;
allow rustiron_app_t self:unix_dgram_socket { create_socket_perms sendto };

# Loopback HTTP/WebSocket server sockets ONLY: apps may bind/listen on high
# unreserved loopback ports; outbound TCP connect (name_connect) is NOT
# granted so a compromised app cannot reach sibling apps on 127.0.0.1.
allow rustiron_app_t self:tcp_socket create_stream_socket_perms;
corenet_tcp_bind_generic_node(rustiron_app_t)
allow rustiron_app_t unreserved_port_t:tcp_socket name_bind;

# Site files: releases/private read-only, data/tmp/logs read-write (MCS keeps
# each app strictly to its own s0:c<N> category).
read_files_pattern(rustiron_app_t, httpd_sys_content_t, httpd_sys_content_t)
read_lnk_files_pattern(rustiron_app_t, httpd_sys_content_t, httpd_sys_content_t)
list_dirs_pattern(rustiron_app_t, httpd_sys_content_t, httpd_sys_content_t)
allow rustiron_app_t httpd_sys_content_t:file map;

manage_files_pattern(rustiron_app_t, httpd_sys_rw_content_t, httpd_sys_rw_content_t)
manage_dirs_pattern(rustiron_app_t, httpd_sys_rw_content_t, httpd_sys_rw_content_t)
manage_lnk_files_pattern(rustiron_app_t, httpd_sys_rw_content_t, httpd_sys_rw_content_t)
allow rustiron_app_t httpd_sys_rw_content_t:file { map lock };

# Runtime libraries, shared data, timezone/locale, certs, CPU/mem info, and
# private /tmp + /dev/shm (scoped per unit by PrivateTmp=yes and tmpfs).
files_read_usr_files(rustiron_app_t)
miscfiles_read_localization(rustiron_app_t)
miscfiles_read_generic_certs(rustiron_app_t)
allow rustiron_app_t passwd_file_t:file read_file_perms;
allow rustiron_app_t proc_t:dir list_dir_perms;
kernel_read_system_state(rustiron_app_t)
dev_read_sysfs(rustiron_app_t)
dev_read_urand(rustiron_app_t)
files_manage_generic_tmp_dirs(rustiron_app_t)
files_manage_generic_tmp_files(rustiron_app_t)
allow rustiron_app_t tmpfs_t:dir manage_dir_perms;
allow rustiron_app_t tmpfs_t:file { manage_file_perms map lock };
allow rustiron_app_t hugetlbfs_t:file { rw_file_perms map };

# Journal logging and systemd stdout/stderr stream.
logging_send_syslog_msg(rustiron_app_t)
init_search_pid_dirs(rustiron_app_t)
allow rustiron_app_t init_t:unix_stream_socket { getattr write };

# Silence benign startup stat/fs probes without granting access (exec,
# cross-site MCS, and outbound TCP connect denials remain fully audited).
dontaudit rustiron_app_t net_conf_t:file { getattr read };
dontaudit rustiron_app_t fs_t:filesystem getattr;
dontaudit rustiron_app_t cgroup_t:filesystem getattr;
dontaudit rustiron_app_t cgroup_t:dir search;
dontaudit rustiron_app_t sysctl_vm_t:file read;
dontaudit rustiron_app_t var_t:dir read;
dontaudit rustiron_app_t nsfs_t:file getattr;
